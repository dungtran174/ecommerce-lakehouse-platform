# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.py text diff=python
*.sql text
*.sh text eol=lf
*.yml text
*.yaml text
*.json text
*.md text
*.txt text
*.conf text
*.xml text
Dockerfile text

# Denote all binary files that should not be modified by Git
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.parquet binary
*.jar binary
*.tar.gz binary
*.zip binary
